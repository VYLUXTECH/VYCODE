{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "small_model": "deepseek/deepseek-chat",
  "enabled_providers": ["deepseek"],
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "vycode-browser-proxy",
        "baseURL": "http://localhost:3002/v1"
      },
      "models": {
        "deepseek-chat": {
          "name": "Instant",
          "attachment": false,
          "reasoning": false,
          "input": ["text"],
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "deepseek-chat-thinking": {
          "name": "Instant Thinking",
          "attachment": false,
          "reasoning": true,
          "input": ["text"],
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "deepseek-chat-search": {
          "name": "Instant Search",
          "attachment": false,
          "reasoning": false,
          "input": ["text"],
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "deepseek-chat-vision": {
          "name": "Vision",
          "attachment": true,
          "reasoning": false,
          "input": ["text", "image"],
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "deepseek-chat-vision-thinking": {
          "name": "Vision Thinking",
          "attachment": true,
          "reasoning": true,
          "input": ["text", "image"],
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "deepseek-reasoner": {
          "name": "Expert Thinking",
          "attachment": false,
          "reasoning": true,
          "input": ["text"],
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "deepseek-reasoner-not": {
          "name": "Expert",
          "attachment": false,
          "reasoning": false,
          "input": ["text"],
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  }
}
